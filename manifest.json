{
  "manifest_version": 3,
  "name": "AO3 Styles for AO3 Advanced Marker",
  "version": "1.0.0",
  "description": "Applies custom styling to AO3 beyond what is capable with site skins.",
  "permissions": ["storage"],
  "host_permissions": ["https://raw.githubusercontent.com/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://archiveofourown.org/*",
        "https://www.archiveofourown.org/*"
      ],
      "css": ["dist/styles.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://archiveofourown.org/works/*",
        "https://www.archiveofourown.org/works/*"
      ],
      "js": ["src/js/collapse-double-breaks.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://archiveofourown.org/*",
        "https://www.archiveofourown.org/*"
      ],
      "js": ["src/js/collapsible-filters.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://archiveofourown.org/works/*",
        "https://www.archiveofourown.org/works/*"
      ],
      "js": ["src/js/marker-reading-status-shelf.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://archiveofourown.org/works/*",
        "https://www.archiveofourown.org/works/*"
      ],
      "js": ["src/js/work-meta-collapse.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://archiveofourown.org/*",
        "https://www.archiveofourown.org/*"
      ],
      "js": ["src/js/mobile-header.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://archiveofourown.org/*",
        "https://www.archiveofourown.org/*"
      ],
      "js": ["src/js/mobile-filters.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://archiveofourown.org/*",
        "https://www.archiveofourown.org/*"
      ],
      "js": ["src/js/live-css-loader.js"],
      "run_at": "document_idle"
    }
  ]
}